meta {
  name: Error - price not positive
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/items
  body: json
  auth: inherit
}

body:json {
  {
    "productName": "Free product {{$timestamp}}",
    "price": 0
  }
}

tests {
  test("returns 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("explains the error", function() {
    expect(res.getBody().detail).to.equal("Item should have a valid positive price");
  });
}
