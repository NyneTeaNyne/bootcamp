meta {
  name: Error - product name already taken
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/items
  body: json
  auth: inherit
}

body:json {
  {
    "productName": "{{productName}}",
    "price": 10
  }
}

tests {
  test("returns 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("explains the error", function() {
    expect(res.getBody().detail).to.equal("Product name already exists");
  });
}
