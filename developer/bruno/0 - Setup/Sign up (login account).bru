meta {
  name: Sign up (login account)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "username": "{{loginUsername}}",
    "password": "{{loginPassword}}"
  }
}

tests {
  test("returns 201 or 400", function() {
    expect([201, 400]).to.include(res.getStatus());
  });
  test("400 only means the account already exists", function() {
    if (res.getStatus() === 400) {
      expect(res.getBody().detail).to.equal("Username already exists");
    }
  });
}

docs {
  Creates the account used to log in (sign-up is public).
  Then: Collection settings > Auth > Get Access Token, and log in with it.
}
