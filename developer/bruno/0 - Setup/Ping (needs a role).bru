meta {
  name: Ping (needs a role)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/ping
  body: none
  auth: inherit
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("answers pong", function() {
    expect(res.getBody()).to.equal("pong");
  });
}

docs {
  Needs the ADMIN or USER role in the token: 401 means no token yet (see Sign up).
}
