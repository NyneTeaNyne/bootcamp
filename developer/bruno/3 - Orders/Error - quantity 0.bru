meta {
  name: Error - quantity 0
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: inherit
}

body:json {
  {
    "customer": {
      "id": {{userId}}
    },
    "items": [
      {
        "id": {{itemId}},
        "quantity": 0
      }
    ]
  }
}

tests {
  test("returns 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("explains the error", function() {
    expect(res.getBody().detail).to.equal("Each item must have a quantity of at least 1");
  });
}
