meta {
  name: Get order
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/orders/{{orderId}}
  body: none
  auth: inherit
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("keeps the quantity", function() {
    expect(res.getBody().items[0].quantity).to.equal(2);
  });
}
