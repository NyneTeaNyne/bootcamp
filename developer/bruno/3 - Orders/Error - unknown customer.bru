meta {
  name: Error - unknown customer
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: inherit
}

body:json {
  {
    "customer": {
      "id": 999999
    },
    "items": [
      {
        "id": {{itemId}}
      }
    ]
  }
}

tests {
  test("returns 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("explains the error", function() {
    expect(res.getBody().detail).to.equal("Customer not found");
  });
}
