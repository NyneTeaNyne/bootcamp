meta {
  name: Error - user not found
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/users/999999
  body: none
  auth: inherit
}

tests {
  test("returns 404", function() {
    expect(res.getStatus()).to.equal(404);
  });
  test("explains the error", function() {
    expect(res.getBody().detail).to.equal("User not found");
  });
}
