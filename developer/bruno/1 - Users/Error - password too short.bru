meta {
  name: Error - password too short
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "username": "short_password_{{$timestamp}}",
    "password": "short"
  }
}

tests {
  test("returns 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("explains the error", function() {
    expect(res.getBody().detail).to.equal("Password must contain between 8 and 72 characters");
  });
}
