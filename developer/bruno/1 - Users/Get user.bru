meta {
  name: Get user
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/users/{{userId}}
  body: none
  auth: inherit
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("is the created customer", function() {
    expect(res.getBody().username).to.equal(bru.getVar("customerUsername"));
  });
}
