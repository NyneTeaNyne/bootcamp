meta {
  name: Error - username already taken
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: none
}

body:json {
  {
    "username": "{{loginUsername}}",
    "password": "AnotherPassw0rd!"
  }
}

tests {
  test("returns 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
  test("explains the error", function() {
    expect(res.getBody().detail).to.equal("Username already exists");
  });
}
