meta {
  name: No token
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/orders
  body: none
  auth: none
}

tests {
  test("returns 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
  test("explains the error", function() {
    expect(res.getBody().detail).to.equal("A valid access token is required");
  });
}
